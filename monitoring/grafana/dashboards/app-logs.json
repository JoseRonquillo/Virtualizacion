{
  "uid": "app-logs",
  "title": "Logs - Aplicaciones parcial-jarm y Traefik",
  "tags": [
    "loki",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
