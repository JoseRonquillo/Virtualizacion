    {
      "type": "timeseries",
      "title": "Volumen de logs por app (lineas/min)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (count_over_time({namespace=\"parcial-jarm\"}[1m]))",
          "legendFormat": "{{app}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
